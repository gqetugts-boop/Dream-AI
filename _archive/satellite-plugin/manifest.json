{
  "manifestVersion": 5,
  "id": "com.huanmeng.ai.satellite",
  "name": "幻梦AI 卫星面板",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "ipc": {
      "enablePluginCommunication": true
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "satellitePanel",
      "label": {
        "default": "幻梦AI 卫星面板"
      },
      "minimumSize": {
        "width": 240,
        "height": 240
      },
      "maximumSize": {
        "width": 1600,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 440
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 440
      }
    },
    {
      "type": "command",
      "id": "satellitePieCommand",
      "label": {
        "default": "幻梦AI 卫星：唤出圆环"
      },
      "shortcut": {
        "mac": "Cmd+Shift+9",
        "windows": "Ctrl+Shift+9"
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon_D.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark"],
      "species": ["generic"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon_N.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ]
}
