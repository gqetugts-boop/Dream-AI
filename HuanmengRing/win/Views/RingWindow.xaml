<Window x:Class="HuanmengRing.Views.RingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HuanmengRing.Views"
        Title="幻梦圆环"
        Width="340" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
        整个 Grid 的 Opacity 由代码驱动：出现时从 0 淡入。
        Opacity 放在容器上而不是 RingCanvas 里，是因为投影那一层是它的兄弟节点，
        放在子节点上投影不会跟着淡入。
    -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="AppearTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- 只有这一层挂投影 Effect。IsHitTestVisible=False 让它不抢鼠标 -->
        <views:SilhouetteLayer x:Name="Silhouette" IsHitTestVisible="False" />

        <views:RingCanvas x:Name="Ring" />
    </Grid>
</Window>
